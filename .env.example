NEXT_PUBLIC_APP_URL=https://your-conferencing-software-url.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

DAILY_API_KEY=your_daily_api_key
CAL_API_KEY=cal_live_or_cal_test_key
CAL_WEBHOOK_SECRET=choose_a_long_random_secret
CRON_SECRET=choose_a_second_long_random_secret
SUPABASE_SERVICE_ROLE_KEY=your_server_only_service_role_key

# Optional custom branded emails. Recommended because Cal.com can send
# request/confirmation emails before webhook-patched locations are reflected.
SEND_ROOM_EMAILS=true
RESEND_API_KEY=your_resend_api_key
ROOM_EMAIL_FROM=RM Tutoring Services <video@rmtutoringservices.com>
ROOM_EMAIL_REPLY_TO=reuben.miller@rmtutoringservices.com

# Optional defaults
ROOM_PREFIX=random-here
ROOM_JOIN_ANYTIME=true
ROOM_OPEN_MINUTES_BEFORE=random-here
ROOM_MAX_PARTICIPANTS=random-here
DAILY_MEETING_TOKEN_TTL_HOURS=720
ROOM_INITIAL_EMAIL_DEDUPE_HOURS=12
